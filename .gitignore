# ─────────────────────────────────────────────
# 环境变量与凭据（绝不要提交）
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# ─────────────────────────────────────────────
# 本地数据库（里面是真实对话，属于隐私数据）
# ─────────────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
loom.db*
# 日记镜像：由数据库所在目录生成，内容是真实日记，不随仓库走
diary/
data/
memory/

# ─────────────────────────────────────────────
# 日志与转储
# ─────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.jsonl
*.ndjson
core
core.*

# ─────────────────────────────────────────────
# 依赖与构建产物
# ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
coverage/
.nyc_output/
dist/
out/
*.tgz
*.tar.gz

# ─────────────────────────────────────────────
# Python（仓库外的辅助脚本可能产生）
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─────────────────────────────────────────────
# 编辑器 / IDE
# ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────
# 操作系统杂项
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─────────────────────────────────────────────
# 本仓库测试脚手架的临时产物
# ─────────────────────────────────────────────
loom-e2e/tmp-*
