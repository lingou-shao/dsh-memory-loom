{
  "name": "dsh-memory-loom",
  "version": "0.2.16",
  "description": "Layered, person-aware long-term memory for DeepSeek Harness: raw turns (L0), atomic facts (L1), event summaries (L2), self-narrative (L3), a subjective layer and a persona card, plus a pointer-only hook index — hooks in the prompt, bodies pulled on demand — all in one local SQLite file",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "memory-index",
    "hook-index",
    "sqlite",
    "consolidation"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "docs",
    "loom-e2e/REPORT.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lingou-shao/dsh-memory-loom.git"
  },
  "bugs": {
    "url": "https://github.com/lingou-shao/dsh-memory-loom/issues"
  },
  "homepage": "https://github.com/lingou-shao/dsh-memory-loom#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "scripts": {
    "test": "node test/selftest.mjs",
    "selftest": "node test/selftest.mjs"
  }
}
